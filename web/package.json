{
  "name": "cloudland-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-novnc.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@novnc/novnc": "^1.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.222.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@scalar/api-reference": "^1.49.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "classnames": "^2.5.1",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.4",
    "vue-tsc": "^2.2.0"
  }
}
