# Project Configuration
API_V1_STR=/api/v1

# Database Configuration (REQUIRED)
# You must provide either DATABASE_URL or POSTGRES_* settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cloudland
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/cloudland


# JWT Settings
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
# Activation token expiration in hours
ACTIVATION_TOKEN_EXPIRE_HOURS=24
# Access token (login session) expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# First Superuser (Root User)
FIRST_SUPERUSER_EMAIL=admin@cloudland.com
FIRST_SUPERUSER_USERNAME=root
FIRST_SUPERUSER_PASSWORD=root_password_change_me

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=Cloudland Platform

# Application URLs
FRONTEND_URL=http://localhost:3000 # 激活邮件里的跳转地址 (前端项目)
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8000

# Default Resource Quotas
DEFAULT_CPU_CORES=4.0
DEFAULT_RAM_GB=8.0
DEFAULT_TRAFFIC_GB=100.0
DEFAULT_PUBLIC_IPS=2
DEFAULT_DISK_GB=50.0

# Advanced Backend Settings
DEFAULT_ADMIN_USERNAME=admin
BACKEND_API_SUFFIX=/api/v1
PROXY_TIMEOUT_SECONDS=30.0
BACKEND_REQUEST_TIMEOUT=10.0
TOKEN_REFRESH_BUFFER_MINUTES=5
AUTO_GENERATED_PW_LENGTH=12
BACKEND_TOKEN_EXPIRE_SECONDS=7200
