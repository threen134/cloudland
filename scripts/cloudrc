source "$localrc"
guest_userid_template=ZCC%05X
run_dir=/opt/cloudland/run
log_dir=/opt/cloudland/log
async_job_dir=$run_dir/async_job
cache_dir=/opt/cloudland/cache
cache_tmp_dir=$cache_dir/tmp
backup_dir=$cache_dir/backup
volume_dir=/opt/cloudland/cache/volume
router_dir=/opt/cloudland/cache/router
image_dir=$cache_dir/instance
image_cache=$cache_dir/image
xml_dir=/opt/cloudland/cache/xml
template_dir=/opt/cloudland/scripts/xml
qemu_agent_dir=/opt/cloudland/cache/qemu_agent
container_dir=/var/lib/lxd/containers
dmasq_dir=/opt/cloudland/cache/dnsmasq
mudata_dir=/opt/cloudland/mudata
snapshot_dir=/var/snapshot
deploy_dir=/opt/cloudland/deploy
vxlan_db=/opt/cloudland/db/cloudland.db
cland_private_key=$deploy_dir/.ssh/cland.key
debug_log_file=/opt/cloudland/log/script.log
debug_flag_file=/opt/cloudland/run/debug
uefi_boot_loader=/usr/share/OVMF/OVMF_CODE_4M.fd
nvram_template=/usr/share/OVMF/OVMF_VARS_4M.fd
# 浮动 IP 策略路由表名（fip-<vlan>）登记在 rt_tables.d：Ubuntu 26.04 的 iproute2 默认配置移到 /usr/share/iproute2，
# /etc/iproute2/rt_tables 不再存在；rt_tables.d/*.conf 在 24.04 与 26.04 上都会被 ip 命令读取
rt_file=/etc/iproute2/rt_tables.d/cloudland.conf

# 登记浮动 IP 策略路由表 fip-<vlan>：按表名判断是否已登记（ID 可能是之前探测得到的其他值），
# 未登记时从 vlan%250+2 开始探测空闲 ID；浮动 IP 与 LB 浮动 IP 共用，保证同一 VLAN 只登记一次
function ensure_fip_table()
{
    local table=fip-$1
    local rtID=$(( $1 % 250 + 2 ))
    mkdir -p $(dirname $rt_file) && touch $rt_file
    grep -qE "^[0-9]+[[:space:]]+$table$" $rt_file && return 0
    for i in {1..250}; do
        grep -qE "^$rtID[[:space:]]" $rt_file || break
        rtID=$(( ($rtID + 17) % 250 + 2 ))
    done
    echo "$rtID $table" >>$rt_file
}
wds_bps_factor=1048576 # 1024 * 1024 
function die()
{
    echo $1
    # 调试日志开启时同时记录失败原因，带上 cloudlet 注入的 trace id 便于与链路关联
    log_debug "$(basename $0)" "die: $1"
    exit -1
}

function wait_vm_status()
{
    local vm_ID=$1
    local status=$2
    # wait for 30 seconds
    for i in {1..60}; do
        local state=$(virsh domstate $vm_ID | sed 's/shut off/shut_off/g')
        [ "$state" = "$status" ] && break
        sleep 0.5
    done
}

function inet_aton()
{
    ip="$1"
    hex=`printf '%02x' ${ip//./ }`
    printf "%lu\n" "0x${hex}"
}

function inet_ntoa()
{
    num="$1"
    hex=`printf "%08x\n" ${num}`
    for i in `echo ${hex} | sed "s/\(..\)/\1 /g"`; do
        printf '%hu.' "0x${i}"
    done | sed "s/\.$//g"
}

function get_tunip()
{
	tunip=$(ifconfig $vxlan_interface | grep 'inet addr' | cut -d: -f2 | cut -d' ' -f1)
	echo "tunip=$tunip" >> $localrc
}

function apply_fw()
{
    action=$1
    chain=$2
    shift
    shift
    rule=$*
    if [ "$action" = '-I' -o "$action" = '-A' ]; then
        rule_no=""
        [ "$chain" = "FORWARD" ] && rule_no=3
        iptables -C $chain $rule 2>/dev/null || iptables $action $chain $rule_no $rule
        return
    elif [ "$action" = '-N' ]; then
        iptables -S $chain || iptables -N $chain
    fi
    iptables $action $chain $rule 2>/dev/null || true
}

function apply_vnic()
{
    action=$1
    vnic=$2
    apply_fw $action FORWARD -m physdev --physdev-in $vnic --physdev-is-bridged -j ACCEPT
    apply_fw $action FORWARD -m physdev --physdev-out $vnic --physdev-is-bridged -j ACCEPT
}

function apply_bridge()
{
    action=$1
    mybr=$2
    if [ "$action" = '-I' -o "$action" = '-A' ]; then
        # 网桥内部放行必须排在安全组跳转之后（apply_fw 把安全组跳转插在 FORWARD 第 3 条），
        # 排在前面会让该网桥上所有虚拟机的安全组失效；追加到链尾并把兜底 REJECT 重新挪到最后
        iptables -C FORWARD -i $mybr -o $mybr -j ACCEPT 2>/dev/null && return
        iptables -A FORWARD -i $mybr -o $mybr -j ACCEPT
        if iptables -C FORWARD -j REJECT --reject-with icmp-host-prohibited 2>/dev/null; then
            iptables -D FORWARD -j REJECT --reject-with icmp-host-prohibited
            iptables -A FORWARD -j REJECT --reject-with icmp-host-prohibited
        fi
        return
    fi
    iptables $action FORWARD -i $mybr -o $mybr -j ACCEPT 2>/dev/null || true
}

function sync_target()
{
    target=$1
    node=$2
    cd $deploy_dir
    group=hyper
    if [ -n "$node" ]; then
        group=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    fi
    ansible $group -u cland -b -a "chown -R cland.cland $target"
    ansible $group -u cland -m synchronize -a "src=$target dest=$target"
    cd -
}

function copy_target()
{
    target=$1
    node=$2
    cd $deploy_dir
    [ -n "$node" ] && hyper_node=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    scp -i $cland_private_key -o StrictHostKeyChecking=no -r ${target} cland@${hyper_node}:${target}
    cd -
}

function action_target()
{
    node=$1
    command=$2
    cd $deploy_dir
    [ -n "$node" ] && hyper_node=$(cat hosts/hosts | grep client_id=$node | awk '{print $1}')
    ssh -i $cland_private_key -o StrictHostKeyChecking=no cland@$hyper_node "$command"
    cd -
}

function sql_exec()
{
    if [ ! -f $vxlan_db ]; then
        mkdir /opt/cloudland/db
        touch $vxlan_db
        sqlite3 $vxlan_db "CREATE TABLE vxlan_rules (id INTEGER PRIMARY KEY AUTOINCREMENT, instance varchar(32), vni INTEGER, inner_ip varchar(32), inner_mac varchar(48), outer_ip varchar(32))"
    fi
    sqlite3 $vxlan_db "$*"
}

function get_wds_token()
{
    [ -z "$wds_token" ] && wds_token="bearer $(curl -L -XPOST -k "$wds_address/api/v1/login" -H "Content-Type: application/json" -d "{\"name\": \"$wds_admin\",\"password\": \"$wds_pass\"}" | jq -r .access_token)"
}

function wds_curl()
{
    action=$1
    path=$2
    data=$3
    [ -z "$data" ] && data='{}'
    get_wds_token
    curl -s -L -X$action -H 'Content-Type: application/json' -H "Authorization: $wds_token" -k "$wds_address/$path" -d "$data"
    echo
}

function get_uss_gateway()
{
    uss_hname=$1
    [ -z "$uss_hname" ] && uss_hname=$(hostname -s)
    uss_id=$(wds_curl GET "api/v2/wds/uss" | jq --arg hname $uss_hname -r '.uss_gateways | .[] | select(.server_name == $hname) | .id')
    [ -n "$uss_id" ] && echo $uss_id
}

function delete_vhost()
{
    [ $# -lt 2 ] && return
    local vol_ID=$1
    local vhost_id=$2
    local uss_unbinded="true"
    local uss_id
    [ $# -eq 3 ] && uss_id=$3 && uss_unbinded="false"

    if [ "$uss_unbinded" == "false" ]; then
        # add retry logic
        local i
        for i in {1..5}; do
            log_debug $vol_ID "Attempting to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id"
            local unbind_ret=$(wds_curl PUT "api/v2/sync/block/vhost/unbind_uss" "{\"vhost_id\": \"$vhost_id\", \"uss_gw_id\": \"$uss_id\", \"is_snapshot\": false}")
            local ret_code=$(echo $unbind_ret | jq -r '.ret_code')
            if [ "$ret_code" == "0" ]; then
                log_debug $vol_ID "Successfully unbound volume($vol_ID)'s vhost $vhost_id from uss $uss_id"
                uss_unbinded="true"
                break
            else
                local err_message=$(echo $unbind_ret | jq -r '.message')
                log_debug $vol_ID "Failed to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id, error message: $err_message"
            fi
            sleep 1
        done
    fi
    if [ "$uss_unbinded" == "true" ]; then
        local vhost_deleted="false"
        log_debug $vol_ID "Proceeding to delete volume($vol_ID)'s vhost $vhost_id"
        local i
        for i in {1..5}; do
            local delete_ret=$(wds_curl DELETE "api/v2/sync/block/vhost/$vhost_id")
            local ret_code=$(echo $delete_ret | jq -r '.ret_code')
            if [ "$ret_code" == "0" ]; then
                log_debug $vol_ID "Successfully deleted volume($vol_ID)'s vhost $vhost_id"
                vhost_deleted="true"
                break
            else
                local err_message=$(echo $delete_ret | jq -r '.message')
                log_debug $vol_ID "Failed to delete volume($vol_ID)'s vhost $vhost_id, error message: $err_message"
            fi
            sleep 1
        done
        if [ "$vhost_deleted" == "true" ]; then
            log_debug $vol_ID "Successfully deleted volume($vol_ID)'s vhost $vhost_id"
        else
            log_debug $vol_ID "Failed to delete volume($vol_ID)'s vhost $vhost_id after multiple attempts"
        fi
    else
        log_debug $vol_ID "Failed to unbind volume($vol_ID)'s vhost $vhost_id from uss $uss_id after multiple attempts; skipping deletion of vhost"
    fi
}

function async_exec()
{
    exec 3<&0
    mkdir -p $async_job_dir
    (
        delayed_log=$async_job_dir/$(date +%s.%N)
        exec 0<&3
        exec >${delayed_log}.in_progress 2>&1
        "$@"
        mv ${delayed_log}.in_progress ${delayed_log}.done
    ) &
    exec 3<&-
}

# 子网网关口（路由器 netns 内 ns-<vlan>）的 MAC：52:<vlan>:<hostid 低 16 位>，由 set_subnet_gw.sh 按此生成；
# set_vrrp_ip.sh 据此识别“只被当作普通网关口建出来、还不是 VRRP 网卡”的设备
function subnet_gw_mac()
{
    local mac_map=$(printf "%06x" $1)
    local hyper_map=$(printf "%04x" $(($SCI_CLIENT_ID & 0xffff)))
    echo 52:${mac_map:0:2}:${mac_map:2:2}:${mac_map:4:2}:${hyper_map:0:2}:${hyper_map:2:2}
}

# 负载均衡进程的锁：配置脚本（create_keepalived_conf.sh / create_haproxy_conf.sh）与心跳里的 check_lb_process.sh
# 并发执行，“判断进程是否存活 → 替换配置 → 启动/重载”必须互斥，否则两边会各起一个进程。
# 持锁时启动的守护进程会继承锁的文件描述符并一直占着锁，启动命令必须带 9>&- 关闭它
lb_lock_file=$run_dir/lb_process.lock

# 负载均衡进程是否在运行：<pid 文件> <配置文件路径>
# pid 文件在进程异常退出、节点重启后会残留，按 cmdline 核对配置路径，避免把信号发给复用了该 pid 的无关进程
function lb_proc_alive()
{
    local pid=$(cat $1 2>/dev/null)
    [ -n "$pid" ] && [ -r /proc/$pid/cmdline ] && tr '\0' ' ' </proc/$pid/cmdline | grep -qF "$2"
}

# 在路由器 netns 内启动负载均衡的 keepalived：<router> <vrrp 目录>
# notify_master（set_route_table.sh）依赖 ROUTES_FILE / KEEPALIVE_CONF 恢复 fip 路由表，必须随进程传入
function start_keepalived()
{
    local router=$1 vrrp_dir=$2
    rm -f $vrrp_dir/keepalived.pid $vrrp_dir/vrrp.pid
    ROUTES_FILE=$vrrp_dir/routes KEEPALIVE_CONF=$vrrp_dir/keepalived.conf \
        ip netns exec $router keepalived -p $vrrp_dir/keepalived.pid -r $vrrp_dir/vrrp.pid -f $vrrp_dir/keepalived.conf 9>&-
}

function log_debug()
{
    # check if parameter count less than 2
    [ $# -lt 2 ] && return
    local vm_ID=$1
    shift
    # check if debug file exists
    if [ -f $debug_flag_file ]; then
        # write log and timestamp to debug log file; TRACEPARENT 由 cloudlet 注入，截取其中 32 位 trace id
        echo "[$(date -u +%Y%m%d%H%M%S)] $vm_ID ${TRACEPARENT:+trace=${TRACEPARENT:3:32} }$*" >> $debug_log_file
    fi
}

function inet_access()
{
    mkdir -p /etc/netns/router-0
    echo "nameserver $dns_server" >/etc/netns/router-0/resolv.conf
    # router-0 的 INPUT 默认 DROP：放行本 netns 主动发起连接的回包。规则常驻、只加不删——
    # 按调用增删时，并发调用（如同一节点同时导入多个镜像）会把别人还在用的规则删掉，导致下载卡住
    ip netns exec router-0 iptables -C INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
        ip netns exec router-0 iptables -A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
    # 最后一条命令即被执行的命令，函数返回它的退出码（如 curl 下载失败）
    ip netns exec router-0 $*
}

function get_uuid_prefix()
{
    [ $# -lt 1 ] && return
    uuid=$1
    prefix=${uuid%%-*}
    echo "$prefix"
}

function wait_qemu_ping()
{
    vm_ID=inst-$1
    num=$2
    [ -z "$num" ] && num=0
    count=0
    for i in {1..240}; do
        virsh qemu-agent-command "$vm_ID" '{"execute":"guest-ping"}'
        if [ $? -eq 0 ]; then
            let count=$count+1
        fi
        [ $count -gt $num ] && break
        sleep 5
    done
}

# ensure_image_cached <img_name> [presigned_download_url]
# 返回: 0=成功 1=失败
# 说明:
#   - 同节点并发启动同一镜像时，flock 串行化，后续调用直接命中缓存
#   - 下载到 .partial 临时文件，成功后原子 mv；中途 kill 也不会留下截断的坏文件
#   - presigned URL 的签名只在请求发起时校验一次，下载过程中到期不会中断
function ensure_image_cached()
{
    local img_name=$1
    local download_url=$2
    local target="$image_cache/$img_name"
    local partial="$target.partial"
    local lock="$image_cache/.$img_name.lock"

    mkdir -p $image_cache

    # 快速路径：已命中
    if [ -s "$target" ]; then
        return 0
    fi

    if [ -z "$download_url" ]; then
        return 1
    fi

    (
        flock -x 9
        # 进入临界区再次检查：可能已被前一个持锁者下载完成
        if [ -s "$target" ]; then
            exit 0
        fi
        trap 'rm -f "$partial"' EXIT INT TERM
        # 内置 MinIO 走 HTTP、外部 S3 走 HTTPS（均验证证书，无 -k）
        # --retry 5 --retry-max-time 600：建连阶段的重试窗口
        curl -s -f --retry 5 --retry-max-time 600 -o "$partial" "$download_url"
        if [ $? -ne 0 ] || [ ! -s "$partial" ]; then
            exit 1
        fi
        mv -f "$partial" "$target"
        trap - EXIT INT TERM
    ) 9>"$lock"
    return $?
}

function sync_vm()
{
    ID=$1
    sed -i "/$1/d" $image_dir/old_inst_list
}
