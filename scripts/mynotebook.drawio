x 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;通过&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;virsh define&lt;/code&gt;注册 XML 配置文件（仅注册不启动）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;调用&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;generate_vm_instance_map.sh&lt;/code&gt;维护监控映射关系；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;配置虚拟机开机自启（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;virsh autostart&lt;/code&gt;）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;同步虚拟机网卡 / VLAN 配置（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;sync_nic_info.sh&lt;/code&gt;）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;执行&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;virsh start&lt;/code&gt;启动虚拟机，根据启动结果更新状态（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;running&lt;/code&gt;/&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;error&lt;/code&gt;）。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quo