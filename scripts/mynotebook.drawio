                </mxCell>
                <mxCell id="6" value="&lt;h4 style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;b style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px; color: rgb(0, 0, 0);&quot;&gt;system_router.sh&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;ul style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); line-height: 2.76px;&quot;&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;创建名为&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;router-0&lt;/code&gt;&amp;nbsp;的网络命名空间；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;调用外部脚本&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;create_veth.sh&lt;/code&gt;，创建一对 veth 虚拟网卡：&lt;/font&gt;&lt;ul style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;主机侧网卡：&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;ext-$ext_vlan&lt;/code&gt;（留在主机命名空间，对接外部网络）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;路由器侧网卡：&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;link-$ext_vlan&lt;/code&gt;（放入&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;router-0&lt;/code&gt;&amp;nbsp;命名空间，作为外网网卡）；&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;为&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;router-0&lt;/code&gt;&amp;nbsp;命名空间内的&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;link-$ext_vlan&lt;/code&gt;&amp;nbsp;网卡配置外部 IP（&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;ext_ip&lt;/code&gt;，带子网掩码）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;为&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;router-0&lt;/code&gt;&amp;nbsp;命名空间设置默认路由，指向网关&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;gateway&lt;/code&gt;（确保流量能转发到外部网络）。&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;默认入站策略&lt;/span&gt;：将&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;INPUT&lt;/code&gt;&amp;nbsp;链默认策略设为&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;DROP&lt;/code&gt;（丢弃所有入站流量）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;封禁 SMTP 端口转发&lt;/span&gt;：检查并添加规则，禁止转发 TCP 25/465/587 端口（邮件发送端口，防垃圾邮件滥用），规则不存在时才插入（避免重复）；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;padding-top: 0px; padding-bottom: 0px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 8px 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style-type: disc; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 7px; line-height: 1.61px;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;配置地址伪装（SNAT）&lt;/span&gt;：检查并添加 NAT 规则，对&amp;nbsp;&lt;code style=&quot;font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); padding: 0px 3.6px; border-radius: 3.6px; scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-feature-settings: normal; font-variation-settings: normal; color: rgb(0, 0, 0);&quot;&gt;link-$ext_vlan&lt;/code&gt;&amp;nbsp;网卡的出站流量做 MASQUERADE（动态地址伪装，类似家用路由器 NAT），规则不存在时才插入。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="620" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;h4 style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0); line-height: 20%;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;create_link.sh&lt;br&gt;&lt;/font&gt;&lt;ol style=&quot;border: 0px solid; box-sizing: border-box; margin-top: 0px; margin-right: 0px; margin-left: 0px; padding: 0px 0px 0px 24px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none; color: rgb(0, 0, 0); font-family: Inter, -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Hiragino Sans GB&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-weight: 400; white-space: normal; margin-bottom: 0px !important;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;如果网桥不存在，创建并配置网桥：&lt;/font&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;使用&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;nmcli&lt;/code&gt;&amp;nbsp;创建网桥连接，名称 / 设备名均为br$vlan，配置静态链路本地地址&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;169.254.169.254/32&lt;/code&gt;&amp;nbsp;且 IPv4 为静态模式；&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;虚拟接口存在性检查：读取&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;/proc/net/dev&lt;/code&gt;&amp;nbsp;检查&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;v-$vlan&lt;/code&gt;&amp;nbsp;格式的虚拟接口是否存在，不存在则进入创建逻辑。&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;按 VLAN 类型创建虚拟接口并加入网桥：&lt;/font&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;若 VLAN ≥ 4095（VXLAN 场景）：未传入自定义&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;interface&lt;/code&gt;&amp;nbsp;则使用&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;cloudrc&lt;/code&gt;&amp;nbsp;中&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;vxlan_interface&lt;/code&gt;，创建 VXLAN 接口（指定 VNI、代理模式、绑定底层接口），关闭 IPv4 并将接口加入网桥；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;若 VLAN &amp;lt; 4095（普通 VLAN 场景）：未传入自定义&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;interface&lt;/code&gt;&amp;nbsp;则使用&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;cloudrc&lt;/code&gt;&amp;nbsp;中&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;vlan_interface&lt;/code&gt;，创建 802.1Q VLAN 接口（指定 VLAN 标签），关闭 IPv4 并将接口加入网桥。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;启用虚拟接口：使用&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;nmcli&lt;/code&gt;&amp;nbsp;启用刚创建的&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;v-$vlan&lt;/code&gt;&amp;nbsp;接口连接。&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h4&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;" parent="1" vertex="1">
                    <mxGeometry x="40" y="750" width="710" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="10" target="7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;h4 style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgba(0, 0, 0, 0.06); color: rgb(0, 0, 0); font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 7px; line-height: 20%;&quot;&gt;create_veth.sh&lt;ol style=&quot;border: 0px solid; box-sizing: border-box; margin-top: 0px; margin-right: 0px; margin-left: 0px; padding: 0px 0px 0px 24px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none; color: rgb(0, 0, 0); font-family: Inter, -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Hiragino Sans GB&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-weight: 400; margin-bottom: 0px !important;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;创建 veth 虚拟网卡对：创建一端为&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$device&lt;/code&gt;、另一端为&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$peerdev&lt;/code&gt;的 veth 设备。&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;迁移对等端 veth 到指定命名空间：将&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$peerdev&lt;/code&gt;端口移入&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$router&lt;/code&gt;对应的网络命名空间。&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;外部网络链路配置（条件执行）：若&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$prefix&lt;/code&gt;为&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;ext(外部类型)&lt;/code&gt;，执行同目录下的&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;create_link.sh&lt;/code&gt;脚本并传入&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$vlan&lt;/code&gt;参数。&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;create_link.sh 将加入物理接口到桥bridge_vlan 下面&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;定义网桥名称：拼接&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;br&lt;/code&gt;和&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$vlan&lt;/code&gt;生成网桥名称（如&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;br100&lt;/code&gt;）。&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;挂载 veth 到网桥：将&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$device&lt;/code&gt;端口挂载到&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;$bridge-vlan&lt;/code&gt;网桥下，使其加入对应二层网络。&lt;/li&gt;&lt;/ol&gt;&lt;/font&gt;&lt;/span&gt;&lt;/h4&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="29" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="12" target="26" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;&lt;b&gt;launch_vm.sh&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;line-height: 20%;&quot;&gt;&lt;ol style=&quot;border: 0px solid; box-sizing: border-box; margin-top: 0px; margin-right: 0px; margin-left: 0px; padding: 0px 0px 0px 24px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none; color: rgb(0, 0, 0); font-family: Inter, -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Hiragino Sans GB&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; margin-bottom: 0px !important;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;div style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0);&quot; class=&quot;auto-hide-last-sibling-br paragraph-JOTKXA paragraph-element br-paragraph-space&quot;&gt;&lt;span style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;参数校验与初始化&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;检查脚本入参数量（至少 12 个），不足则终止并提示用法；（源数据通过标准输入有mac地等网络信息等））&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;定义虚拟机核心参数（ID、名称、CPU、内存、磁盘大小、启动方式、存储池 ID 等），初始化状态变量（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;state=error&lt;/code&gt;、&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;vol_state=error&lt;/code&gt;）。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;div style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0);&quot; class=&quot;auto-hide-last-sibling-br paragraph-JOTKXA paragraph-element br-paragraph-space&quot;&gt;&lt;span style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;元数据解析&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;读取标准输入中的 Base64 编码元数据，解码为 JSON 格式；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;从元数据中提取磁盘 IO 限制（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;sysdisk_iops_limit&lt;/code&gt;/&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;sysdisk_bps_limit&lt;/code&gt;）、操作系统类型（&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;os_code&lt;/code&gt;）等关键字段。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;div style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0);&quot; class=&quot;auto-hide-last-sibling-br paragraph-JOTKXA paragraph-element br-paragraph-space&quot;&gt;&lt;span style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;元数据 ISO 文件生成&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;调用&amp;nbsp;&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;build_meta.sh&lt;/code&gt;&amp;nbsp;生成虚拟机元数据启动盘（ISO 文件），包含实例名称、密钥、网络配置等初始化信息；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;根据启动模式（UEFI / 非 UEFI）选择对应的 XML 模板文件（xml里保护ISO路径，vm启动直接调用ISO的源数据配置VM）。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: decimal;&quot;&gt;&lt;div style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0);&quot; class=&quot;auto-hide-last-sibling-br paragraph-JOTKXA paragraph-element br-paragraph-space&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;&lt;span style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;虚&lt;/span&gt;&lt;span style=&quot;background-color: transparent; border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-weight: 700; color: rgba(0, 0, 0, 0.95);&quot;&gt;本地磁盘场景&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;：&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;ul style=&quot;border: 0px solid; box-sizing: border-box; margin: 0px; padding: 0px 0px 0px 20px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; list-style: none;&quot; class=&quot;auto-hide-last-sibling-br&quot;&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;检查镜像缓存有效性，将镜像转换为 qcow2 格式；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;校验磁盘大小（避免规格小于镜像大小），调整镜像至指定磁盘容量；&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;border: 0px solid; box-sizing: border-box; margin: 8px 0px; padding-top: 0px; padding-bottom: 0px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; color: rgb(0, 0, 0); list-style-type: circle;&quot;&gt;&lt;font style=&quot;font-size: 8px; line-height: 20%;&quot;&gt;登记卷创建状态（成功则设为&lt;code style=&quot;border: 0px none rgb(0, 0, 0); box-sizing: border-box; margin: 0px; padding: 0px 3.6px; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); outline: none; font-family: Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-feature-settings: normal; font-variation-settings: normal; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.06); border-radius: 3.6px; color: rgb(0, 0, 0);&quot;&gt;attached&lt;/code&gt;）。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt