# =============================================================================
# CloudLand Docker 环境变量配置
# 使用方法: cp .env.example .env 然后根据实际环境修改
# =============================================================================

# ---- 网络配置 ----
# 控制平面的公网 IP 地址
# 1. 用于 Web UI、REST API 以及监控界面的主入口地址
# 2. 用于生成 VNC 控制台的代理访问地址（如果不正确设置，界面将无法跳转控制台）
PUBLIC_IP=1.2.3.4

# 控制平面的内部管理网 IP 地址（通常是 10.x.x.x 私网）
# 1. 用于内部组件（clapi, cloudland 等）之间的 RPC 通信
# 2. 用于计算节点 (Hyper) 与控制节点之间的 SCI 通信（9988 端口）
# 3. 用于控制 clapi/consoleproxy/cpgateway 端口映射的监听地址:
#    - 单机部署: 保持默认 127.0.0.1 (仅本机访问，更安全)
#    - 跨机部署: 设置为管理网 IP (如 10.0.0.5)，允许计算节点访问
# 注意: full 模式下 clapi 不应暴露到公网，仅供 cpgateway 内部调用
INTERNAL_IP=10.0.0.5
# cloudland 主控监听的网络设备名 (与 INTERNAL_IP 对应网段的网卡)
NETWORK_DEVICE=eth0
# 管理 VIP（单节点部署填 INTERNAL_IP 即可）
MANAGEMENT_VIP=10.0.0.5

# ---- 部署模式 ----
# 通过组合以下 Profile 控制启用的组件:
#   region - 区域控制面 (cloudland, clapi, consoleproxy, 监控栈)
#   full   - 中央控制面 (nginx + cpgateway + Web UI)
#   dev    - 本地容器化 PostgreSQL
#   minio  - 内置 MinIO 镜像仓库 (不加则使用外部 S3，MinIO 容器不启动)
#
# 常用组合:
#   full,dev,region       → 全量单节点 (推荐，开箱即用，但需外部 S3 才能使用镜像)
#   full,dev,region,minio → 全量单节点 + 内置 MinIO (私有化部署)
#   full,dev              → 仅中央控制面 + 本地 DB (多 Region 架构的中央节点)
#   full,region           → 全量 + 外部 DB (HA 部署)
#   region                → 仅区域控制面 (远程 Region 节点，无认证/UI)
#   dev,region            → 区域控制面 + 本地 DB + cpgateway
COMPOSE_PROFILES=dev,region

# ---- 数据库 ----
# dev 模式: DB_HOST=postgres（连接本地容器）
# 生产/HA 模式: DB_HOST=<外部 DB IP>
DB_HOST=postgres
DB_PORT=5432
# 数据库暴露给宿主机的监听 IP（推荐 127.0.0.1 或与 INTERNAL_IP 相同的内网地址，不推荐公开）
DB_LISTEN_IP=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=d6Passwd
POSTGRES_DB=cloudland

# ---- Control Plane Gateway 控制平面网关配置 (dev/full 模式) ----
CPGATEWAY_DB=cloudland_cpgateway
CPGATEWAY_SECRET_KEY=change-me-in-production
CPGATEWAY_ADMIN_USER=admin

# Region 配置说明 (首次部署后需手动创建)
# Control Plane Gateway 通过 Region 模型管理 clapi 连接，首次部署后需要通过 API 创建 Region 记录
# 默认 Region 的 clapi 内部地址:
#   - 单机部署 (Docker 内部网络): https://clapi:8255
#   - 跨机部署 (使用 INTERNAL_IP): https://${INTERNAL_IP}:8255
# 创建 Region 的 API 端点: POST /api/v1/regions
# 示例请求体:
#   {
#     "name": "default",
#     "display_name": "默认区域",
#     "internal_endpoint": "https://clapi:8255",
#     "internal_secret": "${CPGATEWAY_SECRET_KEY}",
#     "is_available": true
#   }

# ---- 管理员 ----
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=passw0rd

# ---- 通知方式 (Notification) ----
# 用户注册激活通知的发送方式:
#   email  - 通过 SMTP 邮件发送 (默认)
#   feishu - 通过飞书机器人 Webhook 发送
#   both   - 同时发送邮件和飞书
NOTIFICATION_METHOD=email

# ---- 邮件 SMTP 配置 ----
# SMTP 告警配置 (用于 Alertmanager 和 Control Plane Gateway)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_HELLO=example.com
ALERT_SENDER=alert@example.com
SMTP_USER=alert@example.com
SMTP_PASS=changeme
RECEIVER_NAME=cloudland-alerts
ALERT_RECIPIENT=admin@local.com

# ---- 飞书机器人配置 ----
# 飞书自定义机器人 Webhook 地址 (在飞书群设置 > 群机器人中获取)
FEISHU_WEBHOOK_URL=
# 飞书机器人签名校验密钥 (可选，若机器人开启签名校验则必填)
FEISHU_SECRET=

# Slack 告警（可选）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#cloudland-alerts

# Prometheus 通过 http_sd 从 clapi 自动发现采集目标
# 同一 docker-compose 部署: 保持默认 https://clapi:8255
# 跨主机部署: 改为 clapi 的可达地址，如 https://${INTERNAL_IP}:8255
CLAPI_SD_ENDPOINT=https://clapi:8255

# ---- Region Gateway (多 Region 部署) ----
# Region Gateway 是每个远程 Region 的 VNC WebSocket 边缘入口
# 仅在 COMPOSE_PROFILES 包含 region-gateway 时生效
#
# Region Gateway 对外监听端口 (默认 8443，避免与中央 Nginx 443 冲突)
# 生产环境可改为 443
# REGION_GATEWAY_PORT=8443
#
# clapi 返回给前端的 VNC Console 地址
# 单节点模式 (full,dev,region): 留空，自动使用当前请求的 Host（即中央 nginx 地址）
# 多 Region 模式 (region,region-gateway): 设为该 Region 的 Gateway 公网域名或 IP
# CONSOLE_HOST=region1-gw.example.com
# CONSOLE_PORT=8443

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# ---- 内部 DNS (dnsmasq) ----
# 计算节点 hostname 内部解析服务的上游 DNS 转发地址
# 未能匹配内部节点 hostname 的查询将转发到此地址
# 多个地址用逗号分隔，例如: 8.8.8.8,8.8.4.4
DNS_UPSTREAM=8.8.8.8

# ---- 镜像仓库（S3 兼容对象存储）----
# 使用内置 MinIO: COMPOSE_PROFILES 加 minio，如 full,dev,region,minio
# 使用外部 S3:   COMPOSE_PROFILES 不加 minio，MinIO 容器不启动
#
# S3 连接信息（两种模式都用这组变量，只是值不同）
# 为空则不启用 S3 镜像仓库，回退到 legacy 本地模式
S3_ENDPOINT=images.cloudland.internal:9000
S3_ACCESS_KEY=cloudland
# ⚠️ 必填（非空）。内置 MinIO: 与 MINIO_ROOT_PASSWORD 一致 | 外部 S3: 云厂商 Access Secret
S3_SECRET_KEY=
S3_BUCKET=images
# 外部 S3 需要，MinIO 可忽略
S3_REGION=us-east-1
# 内置 MinIO: false | 外部 S3: true
S3_USE_SSL=false
# 镜像上传总超时（分钟），默认 120min；极大镜像（>40GB 或带宽 <100Mbps）上调
S3_UPLOAD_TIMEOUT_MINUTES=120

# MinIO 内部域名（注册到 dnsmasq；compute node 通过此域名访问 MinIO）
MINIO_HOSTNAME=images.cloudland.internal

# ---- capture 上传（compute → clapi → MinIO 转发）----
# compute 节点访问 clapi 的内部 URL（带 /api/v1 前缀）
# 留空则 clapi 启动时基于 CLAPI_HOSTNAME 和 INTERNAL_IP 自动拼接 http://<CLAPI_HOSTNAME>:8255/api/v1
CLAPI_HOSTNAME=clapi.cloudland.internal
CLAPI_INTERNAL_URL=
# ⚠️ 必填（至少 32 位随机串）。用于 HMAC 签发 capture 上传 token
SCI_SHARED_SECRET=

# ---- 内置 MinIO 专用（COMPOSE_PROFILES 含 minio 时生效）----
# ⚠️ 与 S3_ACCESS_KEY / S3_SECRET_KEY 保持一致（.env 不支持变量引用，必须显式填写）
MINIO_ROOT_USER=cloudland
# ⚠️ MinIO 要求至少 8 位，建议 12+ 位强密码
MINIO_ROOT_PASSWORD=

# ---- HA 配置（可选，单节点无需修改）----
#HA_ROLE=MASTER
#PEER_IP=
#VRRP_INTERFACE=eth0
#VRRP_ROUTER_ID=51
#VRRP_AUTH_PASS=cloudland
#VRRP_VIP_MASK=24
#SCI_ENABLE_FAILOVER=yes
