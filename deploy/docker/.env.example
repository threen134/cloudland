# =============================================================================
# CloudLand Docker 环境变量配置
# 使用方法: cp .env.example .env 然后根据实际环境修改
# =============================================================================

# ---- 网络配置 ----
# 控制节点的公网/管理网 IP 地址（hyper 节点需要能访问到此 IP）
PUBLIC_IP=192.168.1.100
# cloudland 主控监听的网络设备名
NETWORK_DEVICE=eth0
# 管理 VIP（单节点部署填控制节点 IP 即可）
MANAGEMENT_VIP=192.168.1.100

# ---- 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=d6Passwd
POSTGRES_DB=cloudland

# ---- 管理员 ----
ADMIN_PASSWORD=passw0rd

# ---- 监控（可选）----
# SMTP 告警配置
SMTP_HOST=smtp.example.com:587
SMTP_HELLO=example.com
ALERT_SENDER=alert@example.com
SMTP_USER=alert@example.com
SMTP_PASS=changeme
RECEIVER_NAME=cloudland-alerts
ALERT_RECIPIENT=admin@example.com

# Slack 告警（可选）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#cloudland-alerts

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
