# ============================================================
# CloudLand 计算节点一键部署参数配置
# 复制此文件为 compute.env 并按需修改后，执行 deploy-compute-node.sh 即可
# ============================================================

# ---- 必填环境配置 ----
CONTROLLER_IP="192.168.1.100"       # 控制节点的 IP 地址（即平台主控 API 地址）
HOSTNAME="hyper01"                  # 本计算节点的名称（最终注册到云平台的 hostname）
NETWORK_DEVICE="eth0"               # 承载系统内部管理网络及 VXLAN 隧道的物理网卡名
VLAN_DEVICE="eth0"                  # 承载外部 VLAN 桥接流量的物理网卡名
DNS_SERVER="8.8.8.8"                # 虚拟机默认分配的 DNS
SCI_CLIENT_ID=0                     # 节点全局唯一 ID（必须从 0 开始严格递增，不可重复）

# ---- 高级拓展配置 ----
DOMAIN="example.com"                # 虚拟机使用的内部基础域名
ZONE_NAME="zone0"                   # 所属可用区
VIRT_TYPE="kvm-x86_64"              # 底层虚拟化类型

# ---- 独立 WDS 存储配置（留空代表不挂载专属外置存储池） ----
#WDS_ADDRESS=""
#WDS_ADMIN=""
#WDS_PASS=""
#WDS_POOL_ID=""
