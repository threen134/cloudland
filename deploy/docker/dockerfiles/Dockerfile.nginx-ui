# =============================================================================
# CloudLand Nginx + UI (Vue.js 静态文件打包)
# 构建: docker build -f dockerfiles/Dockerfile.nginx-ui -t cloudland-nginx-ui ../../
# =============================================================================

# ---- Stage 1: 编译 Vue.js 前端 ----
FROM node:20-alpine AS builder

WORKDIR /build

# 安装依赖
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# 复制源码并构建
COPY web/ ./
# Fix @novnc/novnc top-level await incompatibility with Rollup
RUN sed -i 's/= await _checkWebCodecsH264DecodeSupport();/= false;/' node_modules/@novnc/novnc/lib/util/browser.js
RUN npm run build

# ---- Stage 2: Nginx + 静态文件 ----
FROM nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# 复制 Vue.js 构建产物
COPY --from=builder /build/dist /usr/share/cloudland-ui

# 复制 nginx 配置
COPY deploy/docker/config/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/docker/config/nginx/ssl.conf /etc/nginx/conf.d/ssl.conf
COPY deploy/docker/config/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443 4000

CMD ["nginx", "-g", "daemon off;"]
