# =============================================================================
# CloudLand Nginx + UI (Vue.js 静态文件打包)
# 构建: docker build -f dockerfiles/Dockerfile.nginx-ui -t cloudland-nginx-ui ../../
# =============================================================================

# ---- Stage 1: 编译 Vue.js 前端 ----
FROM node:20-alpine AS builder

WORKDIR /build

# 安装依赖
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# 复制源码并构建
COPY web/ ./
# Fix @novnc/novnc top-level await incompatibility with Rollup
RUN sed -i 's/= await _checkWebCodecsH264DecodeSupport();/= false;/' node_modules/@novnc/novnc/lib/util/browser.js
RUN npm run build

# ---- Stage 2: 编译 Docs ----
FROM node:22-alpine AS builder-docs

WORKDIR /build

# 安装 git (VitePress 构建过程必要)
RUN apk add --no-cache git

# 复制 docs 源码及依赖的外部文件
COPY docs/ ./docs/
COPY api/docs/routes/v1_swagger.json /tmp/api-v1.json
RUN rm -f docs/public/api-v1.json && mv /tmp/api-v1.json docs/public/api-v1.json

RUN cd docs && npm install && npm run docs:build

# ---- Stage 3: Nginx + 静态文件 ----
FROM nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# 复制 Vue.js 构建产物
COPY --from=builder /build/dist /usr/share/cloudland-ui

# 复制 Docs 构建产物
COPY --from=builder-docs /build/docs/.vitepress/dist /usr/share/cloudland-docs

# 复制 nginx 配置
COPY deploy/docker/config/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/docker/config/nginx/ssl.conf /etc/nginx/conf.d/ssl.conf
COPY deploy/docker/config/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443 4000

CMD ["nginx", "-g", "daemon off;"]
