# =============================================================================
# CloudLand Documentation (VitePress)
# 构建: docker build -f dockerfiles/Dockerfile.docs -t cloudland-docs ../../
# =============================================================================

# ---- Stage 1: Build Docs ----
FROM node:22-alpine AS builder

WORKDIR /build

# 安装 git (VitePress 构建过程和某些插件如 Scalar 需要使用 git/Node22)
RUN apk add --no-cache git

# 复制 docs 源码
COPY docs/ ./docs/

# 调试: 验证文件是否存在
RUN ls -la docs/public/api-v1.json

# 编译文档
RUN cd docs && npm install && npm run docs:build

# ---- Stage 2: Serve Docs ----
FROM nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# 复制 VitePress 构建产物
COPY --from=builder /build/docs/.vitepress/dist ./

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
