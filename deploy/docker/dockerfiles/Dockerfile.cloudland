# =============================================================================
# CloudLand 主控服务
# 编译 SCI + cloudland C++ 二进制
# 构建: docker build -f dockerfiles/Dockerfile.cloudland -t cloudland-cland ../../
# =============================================================================

# ---- Stage 1: 编译 SCI 库 ----
FROM ubuntu:22.04 AS sci-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY sci/ /opt/cloudland/sci/
WORKDIR /opt/cloudland/sci
RUN ./configure && make && make install

# ---- Stage 2: 编译 cloudland 二进制 ----
FROM ubuntu:22.04 AS cland-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++ make \
    libssl-dev libjsoncpp-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 从 SCI 构建阶段复制头文件和库
COPY --from=sci-builder /opt/sci /opt/sci

# 复制 cloudland 源码
COPY src/ /opt/cloudland/src/
WORKDIR /opt/cloudland/src

RUN make clean && make && make install

# ---- Stage 3: 运行时镜像 ----
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libjsoncpp25 \
    iproute2 net-tools netbase \
    ca-certificates \
    openssh-client rsync \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash cland

# 复制 SCI 运行时库
COPY --from=sci-builder /opt/sci/lib64 /opt/sci/lib64
COPY --from=sci-builder /opt/sci/bin /opt/sci/bin
COPY --from=sci-builder /opt/sci/sbin /opt/sci/sbin

# 复制 cloudland 二进制和相关文件
COPY --from=cland-builder /opt/cloudland/bin /opt/cloudland/bin
COPY --from=cland-builder /opt/cloudland/lib64 /opt/cloudland/lib64

# 复制脚本
COPY scripts/ /opt/cloudland/scripts/

# 创建必要目录
RUN mkdir -p /opt/cloudland/{log,run,cache,etc} \
    /opt/cloudland/cache/{image,instance,router,meta,volume,dnsmasq,xml} \
    && chown -R cland:cland /opt/cloudland

# 环境变量
ENV SCI_JOB_KEY=12345 \
    SCI_LIB_PATH=/opt/sci/lib64 \
    SCI_AGENT_PATH=/opt/sci/bin \
    SCI_LOG_ENABLE=yes \
    SCI_LOG_DIRECTORY=/opt/cloudland/log \
    SCI_ENABLE_LISTENER=yes \
    SCI_DEVICE_NAME=eth0 \
    SCI_LISTENER_PORT=9988 \
    SCI_USE_EXTLAUNCHER=yes \
    RPC_SERVER_ENDPOINT=0.0.0.0:5006 \
    RPC_REMOTE_ENDPOINT=0.0.0.0:5005 \
    SCI_SEGMENT_SIZE=1048576 \
    MANAGEMENT_VIP=127.0.0.1 \
    LD_LIBRARY_PATH=/opt/sci/lib64

# cloudland 启动脚本
COPY deploy/docker/scripts/cloudland-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9988 5005 5006

USER cland
ENTRYPOINT ["/entrypoint.sh"]
