# cloudlet-go 环境变量（参考 deploy/docker/scripts/deploy-compute-node.sh）
CLAND_ENDPOINT={{ cland_endpoint }}
NODE_ID={{ client_id }}
# 脚本通过 SCI_CLIENT_ID 在回调中标识本节点（cloudlet-go 执行脚本时也会注入）
SCI_CLIENT_ID={{ client_id }}
ZONE_NAME={{ zone_name }}
VIRT_TYPE={{ virt_type }}
GRPC_AUTH_TOKEN={{ grpc_auth_token }}
# 本节点命令并发数，默认 1：按到达顺序串行执行
#CLOUDLET_CONCURRENCY=1
# 链路追踪：Ansible 部署不含 OTel Collector，未设置时不导出
#OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4317
OTEL_RESOURCE_ATTRIBUTES=cloudland.node_id={{ client_id }},cloudland.zone={{ zone_name }}
